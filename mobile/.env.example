# Copy this file to .env and fill in the two Supabase values.
# Find them in Supabase → Project Settings → API. They are the SAME values the
# website uses in NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY.
#
# The anon key is safe to ship in an app: every table it can reach is protected
# by row level security. Never put the service role key here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the Next.js API routes live. Leave as-is for production.
EXPO_PUBLIC_SITE_URL=https://www.groupsbygatherwell.com
